{
  "name": "mockup-erp",
  "description": "Mockup frontend de gestión y control de proyectos para SurTec y J&Y, con tres presentaciones estáticas.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-modern/index.html",
  "homepage": "https://github.com/JeanEstrada-2004/Mockup-ERP",
  "author": "Jean Estrada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeanEstrada-2004/Mockup-ERP.git"
  },
  "bugs": {
    "url": "https://github.com/JeanEstrada-2004/Mockup-ERP/issues"
  },
  "license": "MIT",
  "keywords": [
    "erp",
    "proyectos",
    "surtec",
    "jy",
    "mockup",
    "bootstrap",
    "bootstrap5",
    "alpinejs",
    "d3",
    "vite",
    "scss",
    "dark-mode",
    "responsive",
    "modern"
  ],
  "files": [
    "dist-modern/**/*",
    "src-modern/**/*",
    "public-assets/**/*",
    "scripts/**/*",
    "docs/**/*",
    "vite.config.js",
    "postcss.config.js",
    "eslint.config.js",
    ".prettierrc.json",
    ".nvmrc",
    "PRODUCT.md",
    "DESIGN.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:surtec": "vite --mode surtec-peti --port 3000 --strictPort",
    "dev:jy-pmi": "vite --mode jy-pmi --port 3001 --strictPort",
    "dev:jy-demo": "vite --mode jy-demo --port 3002 --strictPort",
    "dev:host": "vite --host",
    "build": "vite build",
    "build:variants": "npm run check:mock-data && node scripts/build-variants.mjs",
    "check:mock-data": "node scripts/validate-mock-data.mjs",
    "test:shell": "node scripts/shell-interaction-test.mjs",
    "test:commercial": "node scripts/commercial-interaction-test.mjs",
    "test:expenses": "node scripts/expense-interaction-test.mjs",
    "test:personnel": "node scripts/personnel-interaction-test.mjs",
    "test:warehouse": "node scripts/warehouse-interaction-test.mjs",
    "test:costs": "node scripts/cost-interaction-test.mjs",
    "test:delivery9": "node scripts/delivery-nine-interaction-test.mjs",
    "test:delivery10": "node scripts/verify-delivery-ten.mjs",
    "test:masters": "node scripts/masters-interaction-test.mjs",
    "test:jy-expenses": "node scripts/expense-review-interaction-test.mjs",
    "test:jy-control": "node scripts/jy-control-interaction-test.mjs",
    "test:jy-budgets": "node scripts/jy-budgets-interaction-test.mjs",
    "test:jy-personnel": "node scripts/jy-personnel-interaction-test.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "preview": "vite preview",
    "serve": "vite build && vite preview",
    "lint": "eslint src-modern/",
    "lint:fix": "eslint src-modern/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icon-subset.mjs",
    "check": "npm run lint && npm run format:check",
    "clean": "rimraf dist dist-modern",
    "clean:all": "rimraf dist dist-modern node_modules package-lock.json",
    "test": "node scripts/smoke-test.mjs",
    "test:build": "npm run build && node scripts/smoke-test.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run check:mock-data && npm run build:variants && npm run test:delivery10 && npm run test:build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@popperjs/core": "^2.11.8",
    "alpinejs": "^3.17.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "d3-array": "^3.2.5",
    "d3-ease": "^3.0.2",
    "d3-interpolate": "^3.0.2",
    "d3-random": "^3.0.2",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "d3-transition": "^3.0.2",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.104.0",
    "vite": "^8.2.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  }
}
